# ==============================================================================
# CEVI KURSTRACKER - LOKALE ENTWICKLUNGS-UMGEBUNG (.env.local.example)
# ==============================================================================
# Verwendung:
#   Kopiere diesen Inhalt in .env.local:
#   copy .env.local.example .env.local
# ==============================================================================

# Umgebungs-Identifikation
APP_ENV=local
NODE_ENV=development
APP_NAME="Cevi Kurstracker [LOCAL]"

# Server & Netzwerk
PORT=3000
HOST=localhost
APP_URL=http://localhost:3000

# Cevi-DB Integration (Vorbereitungsmodus gemäss https://wiki.cevi.ch/index.php/Cevi.DB_API)
# Die Anbindung ist vorbreitet; im Vorbereitungsmodus werden lokale Testdaten simuliert.
CEVI_DB_BASE_URL=https://db.cevi.ch
CEVI_DB_PREPARATION_MODE=true
CEVI_DB_CLIENT_ID=local_dev_client_id
CEVI_DB_CLIENT_SECRET=local_dev_client_secret
CEVI_DB_REDIRECT_URI=http://localhost:3000/api/auth/callback
CEVI_DB_SCOPES="openid email name with_roles events people"
CEVI_DB_SERVICE_TOKEN=
CEVI_DB_USE_MOCK=true

# Session & Cookies (Lokal kein HTTPS erforderlich)
SESSION_SECRET=local-development-secret-key-cevi-tracker-9876543210
COOKIE_SECURE=false

# Logging
LOG_LEVEL=debug
