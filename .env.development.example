# ==============================================================================
# CEVI KURSTRACKER - DEVELOPMENT / STAGING WEBSERVER (.env.development.example)
# ==============================================================================
# Verwendung:
#   Kopiere diesen Inhalt auf dem Dev-Webserver in .env.development oder .env:
#   cp .env.development.example .env
# ==============================================================================

# Umgebungs-Identifikation
APP_ENV=development
NODE_ENV=development
APP_NAME="Cevi Kurstracker [DEV-SERVER]"

# Server & Netzwerk (z.B. hinter Nginx / Reverse Proxy)
PORT=3000
HOST=0.0.0.0
APP_URL=https://dev.kurstracker.ch

# Cevi-DB Integration (gemäss https://wiki.cevi.ch/index.php/Cevi.DB_API)
CEVI_DB_BASE_URL=https://db.cevi.ch
# Solange keine Registrierung vorliegt, auf true belassen:
CEVI_DB_PREPARATION_MODE=true
CEVI_DB_CLIENT_ID=your_staging_cevi_db_client_id
CEVI_DB_CLIENT_SECRET=your_staging_cevi_db_client_secret
CEVI_DB_REDIRECT_URI=https://dev.kurstracker.ch/api/auth/callback
CEVI_DB_SCOPES="openid email name with_roles events people"
CEVI_DB_SERVICE_TOKEN=
CEVI_DB_USE_MOCK=false

# Session & Cookies (HTTPS auf Webserver aktiviert)
SESSION_SECRET=dev-server-random-crypto-secret-replace-in-actual-environment
COOKIE_SECURE=true

# Logging
LOG_LEVEL=info
