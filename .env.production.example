# ==============================================================================
# CEVI KURSTRACKER - LIVE / PRODUCTION WEBSERVER (.env.production.example)
# ==============================================================================
# Verwendung:
#   Kopiere diesen Inhalt auf dem Live-Produktionsserver in .env:
#   cp .env.production.example .env
#   WICHTIG: Setze alle echten Produktionsgeheimnisse und HTTPS URLs ein!
# ==============================================================================

# Umgebungs-Identifikation
APP_ENV=production
NODE_ENV=production
APP_NAME="Cevi Kurstracker"

# Server & Netzwerk (z.B. hinter Nginx / Traefik / Caddy)
PORT=3000
HOST=0.0.0.0
APP_URL=https://kurstracker.ch

# Cevi-DB Integration (gemäss https://wiki.cevi.ch/index.php/Cevi.DB_API)
CEVI_DB_BASE_URL=https://db.cevi.ch
# Auf 'false' setzen, sobald die offizielle OAuth-Applikation bei cevidb@cevi.ch registriert ist:
CEVI_DB_PREPARATION_MODE=true
CEVI_DB_CLIENT_ID=official_live_cevi_db_client_id
CEVI_DB_CLIENT_SECRET=official_live_cevi_db_client_secret
CEVI_DB_REDIRECT_URI=https://kurstracker.ch/api/auth/callback
CEVI_DB_SCOPES="openid email name with_roles events people"
CEVI_DB_SERVICE_TOKEN=
CEVI_DB_USE_MOCK=false

# Session & Cookies (Strenge Sicherheit & HTTPS)
SESSION_SECRET=live-production-high-entropy-crypto-secret-key-32chars-min
COOKIE_SECURE=true

# Logging (Nur Warnungen & Fehler im Livebetrieb für Performance und Datenschutz)
LOG_LEVEL=warn
