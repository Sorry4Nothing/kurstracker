# ==============================================================================
# CEVI KURSTRACKER - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM TOOLS / ASSISTANTS (Strict Rule: NEVER COMMIT ANY AI FILES)
# ------------------------------------------------------------------------------
# Gemini & Google Antigravity
.*gemini*
*gemini*
.agents/
.agents*
*brain*
brain/

# Claude & Anthropic
.*claude*
*claude*
.anthropic*
*clinerules*
CLAUDE*

# Cursor & Windsurf & Codeium
.*cursor*
*cursor*
.cursorrules*
.cursorignore*
.*windsurf*
*windsurf*
.*codeium*
*codeium*

# Copilot & OpenAI & Prompt/AI Artifacts
.*copilot*
*copilot*
*openai*
*.prompt
*.prompts
prompt_*.txt
*.chat
*.ai
ai-context/
ai_logs/
ai-artifacts/


# ------------------------------------------------------------------------------
# 2. ENVIRONMENT & SECRETS (Multi-Environment Separation)
# ------------------------------------------------------------------------------
# Ignore all actual environment and secret files
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
*.local.json
secrets/

# DO NOT IGNORE the example templates:
!.env.example
!.env.local.example
!.env.development.example
!.env.production.example

# ------------------------------------------------------------------------------
# 3. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 4. BUILD ARTIFACTS & CACHES
# ------------------------------------------------------------------------------
dist/
build/
out/
.next/
.cache/
.parcel-cache/
.turbo/
coverage/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 5. OS & EDITOR ARTIFACTS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ------------------------------------------------------------------------------
# 6. RUNTIME DATA & LOGS
# ------------------------------------------------------------------------------
logs/
*.log
tmp/
temp/
scratch/
