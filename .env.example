# ==============================================================================
# CEVI KURSTRACKER - ALLGEMEINE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Kopiere diese Datei oder eine der spezifischen Vorlagen:
#   Lokale Entwicklung:       cp .env.local.example .env.local
#   Dev/Staging-Webserver:    cp .env.development.example .env.development
#   Live/Production:          cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UMGEBUNGS-IDENTIFIKATION
# ------------------------------------------------------------------------------
# Mögliche Werte für APP_ENV: 'local' | 'development' | 'production'
APP_ENV=local

# Standard Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Name der Anwendung für Logs & Header
APP_NAME="Cevi Kurstracker"

# ------------------------------------------------------------------------------
# 2. SERVER & NETZWERK
# ------------------------------------------------------------------------------
PORT=3000
HOST=localhost

# Öffentliche Basis-URL (wichtig für Cevi-DB OAuth Callbacks!)
# Lokal: http://localhost:3000
# Dev:   https://dev.kurstracker.ch
# Live:  https://kurstracker.ch
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. CEVI-DB (HITOBITO) OAUTH & API INTEGRATION
# ------------------------------------------------------------------------------
# Basis-URL der Cevi-DB (Standard: https://db.cevi.ch)
CEVI_DB_BASE_URL=https://db.cevi.ch

# OAuth 2.0 Client Credentials (erhältlich vom Cevi Schweiz DB-Administrator)
CEVI_DB_CLIENT_ID=your_cevi_db_client_id_here
CEVI_DB_CLIENT_SECRET=your_cevi_db_client_secret_here

# Redirect URI muss exakt mit der im Cevi-DB OAuth Backend hinterlegten übereinstimmen!
CEVI_DB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Angeforderte Scopes (openid für Login, email, name, with_roles für Gruppen/Rollen, events für Kurse)
CEVI_DB_SCOPES="openid email name with_roles events"

# Mock-Modus für lokale Entwicklung ohne echte Cevi-DB Credentials (true | false)
CEVI_DB_USE_MOCK=true

# ------------------------------------------------------------------------------
# 4. SICHERHEIT & SESSION
# ------------------------------------------------------------------------------
# Zufälliger, sicherer String für Session-Signierung (min. 32 Zeichen)
SESSION_SECRET=change-this-to-a-very-long-and-secure-random-secret-key-12345

# Cookie Security (Lokal: false; Dev/Prod mit HTTPS: true)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. LOGGING & DEBUG
# ------------------------------------------------------------------------------
# Log Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=debug
