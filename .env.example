# Cevi Kurstracker - Environment Configuration
APP_ENV=local
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-secure-random-secret

# Cevi-DB (Hitobito) Integration
# https://wiki.cevi.ch/index.php/Cevi.DB_API
CEVI_DB_BASE_URL=https://db.cevi.ch
CEVI_DB_PREPARATION_MODE=true
CEVI_DB_CLIENT_ID=
CEVI_DB_CLIENT_SECRET=
CEVI_DB_REDIRECT_URI=http://localhost:3000/api/auth/callback
CEVI_DB_SERVICE_TOKEN=

# Betrieb hinter einem Reverse Proxy (Produktion): Anzahl Proxy-Hops, z. B. 1.
# Damit zählt das Rate Limit die echte Client-IP, und HTTP wird auf HTTPS (APP_URL) umgeleitet.
TRUST_PROXY=
